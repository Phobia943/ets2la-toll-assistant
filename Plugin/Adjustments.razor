@page "/plugins/adjustments/local.mautassistent"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

<div class="flex flex-col m-5 ml-8 gap-4" style="max-width:850px">
    <h1 style="font-size:24px">Mautassistent</h1>
    <p>@(TollPlugin.Current?.Status ?? "Plugin noch nicht geladen")</p>
    <p>@TollPlugin.Current?.Details</p>
    <p>@TollPlugin.Current?.DataStatus</p>
    <p>@TollPlugin.Current?.RouteStatus</p>
    @if (TollPlugin.Current?.LaneChoices is { Length: >0 } choices) {
        <label>Lkw-taugliche Spur
            <select style="border:1px solid #777;border-radius:5px;padding:6px" @bind="lane" @bind:after="LaneChanged">
                <option value="-1">Spur auswählen</option>
                @foreach(var choice in choices) {<option value="@choice.GateId">@choice.Label</option>}
            </select>
        </label>
        <label>Zahlart dieser Spur
            <select style="border:1px solid #777;border-radius:5px;padding:6px" @bind="payment">
                <option value="@TollPayment.Unknown">Noch nicht sicher erkannt</option>
                <option value="@TollPayment.Automatic">Automatische Abrechnung, keine Bestätigung nötig</option>
                <option value="@TollPayment.Manual">Manuell bezahlen / Ticket bestätigen</option>
            </select>
        </label>
        <button style="padding:10px;border:1px solid #777;border-radius:6px" @onclick="ConfirmLane">Lkw-Freigabe und Zahlart dieser Spur speichern</button>
    }
    <p>Die Spurwahl nutzt die Zahlart im Spielmodell und prüft den gesamten Lkw-Weg. Sie bevorzugt automatische Abrechnung. Bei einer manuellen Zahlspur hält die Assistenz vor der Schranke. Fehlt eine passende Spur, nähert sich der Lkw dem Haltepunkt vor der Aufteilung. F9 gibt die Steuerung zurück.</p>
    <button style="padding:10px;border:1px solid #777;border-radius:6px" @onclick="Preview">Route im Stand prüfen (ohne Gas und Lenkung)</button>
    <p>Bereitet sich im Stand automatisch vor, sobald Spiel, Pathfinding und Tempomat bereit sind. Die Fahrt startet erst mit F8; F9 gibt die Steuerung zurück. Spurwahl und Halteabstand müssen für die jeweilige Mautstelle und den Lkw geprüft werden.</p>
    <label>Anfahrt (km/h) <input style="border:1px solid #777;border-radius:5px;padding:4px;width:80px" type="number" min="5" max="30" @bind="approach" /></label>
    <label>Durchfahrt (km/h) <input style="border:1px solid #777;border-radius:5px;padding:4px;width:80px" type="number" min="3" max="15" @bind="passage" /></label>
    <label>Halteabstand zum Lkw-Messpunkt (m) <input style="border:1px solid #777;border-radius:5px;padding:4px;width:80px" type="number" min="4" max="15" @bind="offset" /></label>
    <p>Der Messpunkt ist nicht die Stoßstange. Der passende Wert muss mit deinem Lkw geprüft werden.</p>
    <label>Warten nach vollständig geöffneter Schranke (s) <input style="border:1px solid #777;border-radius:5px;padding:4px;width:80px" type="number" min="1" max="10" step="0.5" @bind="delay" /></label>
    <button style="padding:10px;border:1px solid #777;border-radius:6px" @onclick="Apply">Einstellungen speichern</button>
    <button style="padding:10px;border:1px solid #777;border-radius:6px" @onclick="Observe">Nur beobachten / Fehlerbremsung lösen</button>
    <button style="padding:10px;border:1px solid #b58a6f;border-radius:6px" @onclick="Activate">Vorbereitung jetzt prüfen (optional)</button>
    <p>@message</p>
    <p>Zum Einschalten: Fahrassistenz auslassen, im Stand auf „Bereit“ warten, dann F8. Nach dem ETS2LA-Start ist kein Klick auf eine Vorbereitungsschaltfläche nötig.</p>
    <p>Bei fehlenden Daten oder während der Fahrt erfolgt keine neue Vorbereitung. Nach einer Störung zuerst mit F9 übernehmen und anhalten; danach wird automatisch erneut vorbereitet. Ein normaler Stopp mit F9 bleibt startbereit. „Nur beobachten“ pausiert die automatische Vorbereitung bis F9 oder bis zur manuellen Vorbereitung.</p>
    <p>Bei Trackingverlust oder falscher Fahrtrichtung wird die Lenkassistenz ausgeschaltet und starkes Bremsen angefordert. Die Fehlerbremsung bleibt bis zur manuellen Übernahme mit F9 aktiv, auch im Stand. Dann selbst die Bremse halten. F8 kann die Fehlerbremsung nicht lösen. Kein automatisches Bezahlen und keine Schrankenmanipulation.</p>
    <p>Diagnose: @TollPlugin.Current?.DiagnosticPath</p>
</div>
@code {
    double approach=20, passage=10, offset=8, delay=2;
    string message="";
    int lane=-1;
    TollPayment payment=TollPayment.Unknown;
    readonly CancellationTokenSource stop = new();
    protected override void OnInitialized() {
        var o=TollPlugin.Current?.Options;
        lane=TollPlugin.Current?.SelectedLane ?? -1;
        if(o != null) { approach=o.ApproachSpeedKph; passage=o.PassageSpeedKph; offset=o.StopOffsetMetres; delay=o.OpenDelaySeconds; }
        _=Refresh();
    }
    async Task Refresh() {
        try { using var timer=new PeriodicTimer(TimeSpan.FromSeconds(1)); while(await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(StateHasChanged); }
        catch(OperationCanceledException) { }
    }
    void Apply() => message=TollPlugin.Current?.Configure(new TollOptions { ApproachSpeedKph=approach, PassageSpeedKph=passage, StopOffsetMetres=offset, OpenDelaySeconds=delay }) ?? "Plugin fehlt";
    void Observe() => message=TollPlugin.Current?.SetActive(false) ?? "Plugin fehlt";
    void Preview() => message=TollPlugin.Current?.PreviewRoute() ?? "Plugin fehlt";
    void ConfirmLane() => message=TollPlugin.Current?.ConfirmLane(lane,payment) ?? "Plugin fehlt";
    void LaneChanged() => payment=TollPayment.Unknown;
    void Activate() => message=TollPlugin.Current?.SetActive(true) ?? "Plugin fehlt";
    public void Dispose() { stop.Cancel(); stop.Dispose(); }
}
